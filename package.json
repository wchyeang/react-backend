{
  "name": "react-backend",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "^3.1.15-7",
    "@reduxjs/toolkit": "^2.6.1",
    "ahooks": "^3.8.0",
    "antd": "^6.6.6",
    "axios": "^1.8.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-intl": "^7.1.8",
    "react-redux": "^9.2.0",
    "react-router": "^7.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "3.2.6",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.3",
    "prettier": "^3.5.3",
    "sass": "^1.86.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.0"
